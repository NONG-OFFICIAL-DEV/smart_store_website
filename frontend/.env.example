# Nuxt runtime config (see nuxt.config.ts's runtimeConfig.public) — unlike
# the old Vite app's VITE_APP_* build-time vars, these are read at container
# start, so the same built image works across environments without a rebuild.
#
# CMS: this project's own Laravel backend (marketing content, admin panel auth).
# Smart Store / Studio: the two real products' own live, independent backends —
# this site never owns their data, only links out to their app/API URLs.
# Local dev: http://127.0.0.1:8000/api/v1
# Production: https://www.nexstacktech.com/api/v1
NUXT_PUBLIC_CMS_API_URL=https://www.nexstacktech.com/api/v1
NUXT_PUBLIC_SMART_STORE_API_URL=https://admin.nexstacktech.com/api/
NUXT_PUBLIC_SMART_STORE_APP_URL=https://admin.nexstacktech.com
NUXT_PUBLIC_STUDIO_API_URL=https://photo-studio.nexstacktech.com/api/v1
NUXT_PUBLIC_STUDIO_APP_URL=https://photo-studio.nexstacktech.com
